---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { projects, paperById, topics, topicById, url } from '../utils/data';
const sel = 'w-full sm:w-auto rounded-xl border-0 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none ring-1 ring-black/5 focus:ring-2 focus:ring-teal-500/50 dark:bg-white/[.06] dark:text-slate-200 dark:ring-white/10';
---
<Base title="Projects" description="Open-source AI4SE research projects, alphabetical.">
  <PageHeader eyebrow={`Open source / ${projects.length} projects / A–Z`} title="Open-source" accent="projects." lead="Research tools, agents and benchmarks with public repositories, listed alphabetically." />
  <div class="mb-6 flex flex-wrap gap-2">
    <label class="sr-only" for="j-q">Search projects</label>
    <input id="j-q" type="search" placeholder="Search projects…" class={sel + ' min-w-52 flex-1'} />
    <label class="sr-only" for="j-topic">Topic</label>
    <select id="j-topic" class={sel}><option value="">All topics</option>{topics.map((t) => <option value={t.id}>{t.name}</option>)}</select>
  </div>
  <ul class="space-y-5">
    {projects.map((p, i) => {
      const [owner, repo] = p.repository.replace('https://github.com/', '').split('/');
      return (
      <li data-item data-topics={p.topics.join(' ')} data-text={(p.name + ' ' + p.description).toLowerCase()} class="result-enter">
        <article class="rounded-2xl bg-white ring-1 ring-black/[.06] shadow-[0_1px_2px_rgba(0,0,0,.04),0_8px_24px_-12px_rgba(0,0,0,.12)] dark:bg-white/[.04] dark:ring-white/10 dark:shadow-none transition hover:-translate-y-0.5 hover:shadow-[0_2px_4px_rgba(0,0,0,.05),0_16px_32px_-12px_rgba(0,0,0,.18)] hover:ring-black/10 dark:hover:bg-white/[.06] dark:hover:ring-white/20 overflow-hidden">
          <div class="flex gap-5 p-6 sm:p-7">
            <span class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#f5f5f7] font-mono sm:flex text-base font-semibold tabular-nums text-slate-900 ring-1 ring-black/[.06] dark:bg-white/[.06] dark:text-white dark:ring-white/15" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="min-w-0 flex-1">
              <h2 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">{p.name}</h2>
              <p class="mt-0.5 truncate font-mono text-xs tracking-wide text-slate-500 dark:text-slate-400">{owner} / {repo}</p>
              <p class="mt-3 max-w-3xl text-[16px] leading-relaxed tracking-[0.005em] text-slate-600 dark:text-slate-400">{p.description}</p>
              <dl class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-[auto_1fr]">
                <dt class="text-[11px] font-medium uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400 pt-1">Topics</dt>
                <dd class="flex flex-wrap gap-2">{p.topics.map((t) => <a href={url(`topics/${t}/`)} class="rounded-full bg-black/5 px-2.5 py-1 text-xs text-slate-700 dark:bg-white/10 dark:text-slate-300 hover:bg-black/10 dark:hover:bg-white/15">{topicById.get(t)?.short_name ?? t}</a>)}</dd>
                {p.related_papers && p.related_papers.length > 0 && <>
                  <dt class="text-[11px] font-medium uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400 pt-0.5">Paper</dt>
                  <dd class="text-sm text-slate-700 dark:text-slate-300">{p.related_papers.map((id) => paperById.get(id)!).map((pp, i) => <>{i > 0 && ', '}<a class="hover:underline" href={url(`papers/${pp.id}/`)}>{pp.title.split(':')[0]} ({pp.year})</a></>)}</dd>
                </>}
              </dl>
            </div>
          </div>
          <div class="flex items-center justify-between border-t border-black/[.06] bg-slate-50/70 px-6 py-3 sm:px-7 dark:border-white/10 dark:bg-white/[.02]">
            <span class="text-xs text-slate-500 dark:text-slate-400">Checked {p.last_verified}</span>
            <a href={p.repository} class="inline-flex items-center gap-1.5 rounded-full bg-slate-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">Repository ↗</a>
          </div>
        </article>
      </li>);
    })}
  </ul>
  <p id="j-empty" class="mt-4 hidden rounded-xl border border-dashed border-slate-300 p-8 text-center text-slate-500 dark:border-slate-700">No project matches.</p>
  <script>
    const q = document.getElementById('j-q') as HTMLInputElement, topic = document.getElementById('j-topic') as HTMLSelectElement;
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    function apply() {
      const w = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean); let n = 0;
      for (const el of items) { const ok = w.every((x) => el.dataset.text!.includes(x)) && (!topic.value || el.dataset.topics!.split(' ').includes(topic.value)); el.hidden = !ok; if (ok) n++; }
      document.getElementById('j-empty')!.classList.toggle('hidden', n > 0);
    }
    q.addEventListener('input', apply); topic.addEventListener('change', apply);
    apply();
  </script>
</Base>
