---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TopicChip from '../components/TopicChip.astro';
import { projects, paperById, topics } from '../utils/data';
const sel = 'rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900';
---
<Base title="Projects" description="Open-source AI4SE research projects, alphabetical.">
  <PageHeader eyebrow="Open source" title="Open-source projects" lead="Research tools, agents and benchmarks with public repositories, listed alphabetically." />
  <div class="mb-6 flex flex-wrap gap-2">
    <label class="sr-only" for="j-q">Search projects</label>
    <input id="j-q" type="search" placeholder="Search projects…" class={sel + ' min-w-52 flex-1'} />
    <label class="sr-only" for="j-topic">Topic</label>
    <select id="j-topic" class={sel}><option value="">All topics</option>{topics.map((t) => <option value={t.id}>{t.name}</option>)}</select>
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((p) => (
      <article data-item data-topics={p.topics.join(' ')} data-text={(p.name + ' ' + p.description).toLowerCase()} class="card result-enter flex flex-col rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <h2 class="font-semibold text-slate-900 dark:text-white"><a href={p.repository} class="hover:underline">{p.name}</a></h2>
        <p class="mt-1 flex-1 text-sm text-slate-600 dark:text-slate-400">{p.description}</p>
        <div class="mt-3 flex flex-wrap gap-1">{p.topics.map((t) => <TopicChip id={t} />)}</div>
        {p.related_papers && p.related_papers.length > 0 && (
          <p class="mt-3 text-xs text-slate-500">Paper: {p.related_papers.map((id, i) => { const pp = paperById.get(id)!; return <>{i > 0 && ' · '}<a class="underline" href={pp.links.paper}>{pp.title.split(':')[0]} ({pp.year})</a></>; })}</p>
        )}
        <a href={p.repository} class="mt-3 truncate font-mono text-xs text-indigo-600 hover:underline dark:text-indigo-400">{p.repository.replace('https://github.com/', 'github.com/')}</a>
      </article>
    ))}
  </div>
  <p id="j-empty" class="mt-4 hidden rounded-xl border border-dashed border-slate-300 p-8 text-center text-slate-500 dark:border-slate-700">No project matches.</p>
  <script>
    const q = document.getElementById('j-q') as HTMLInputElement, topic = document.getElementById('j-topic') as HTMLSelectElement;
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    function apply() {
      const w = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean); let n = 0;
      for (const el of items) { const ok = w.every((x) => el.dataset.text!.includes(x)) && (!topic.value || el.dataset.topics!.split(' ').includes(topic.value)); el.hidden = !ok; if (ok) n++; }
      document.getElementById('j-empty')!.classList.toggle('hidden', n > 0);
    }
    q.addEventListener('input', apply); topic.addEventListener('change', apply);
    apply();
  </script>
</Base>
