---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
const steps = [
  ['Open an issue or a pull request', 'Use one of the templates: add a researcher, a paper or a project, or report a correction.'],
  ['Automated validation', 'GitHub Actions checks required fields, schemas, topic IDs, URLs and duplicates.'],
  ['Maintainer review', 'The maintainer checks the sources, the topic assignment and the wording.'],
  ['Merged and published', 'After the merge, the site rebuilds automatically. Reviews happen every Saturday.'],
];
const code = 'block overflow-x-auto rounded-xl bg-slate-900 p-4 font-mono text-xs leading-relaxed text-slate-100';
---
<Base title="Contribute" description="How to add or correct records in AI4SE Atlas.">
  <PageHeader eyebrow="Community / pull requests / weekly review" title="Help map" accent="the field." lead="Everyone can suggest records. All changes are reviewed by the maintainer before they are merged." />
  <ol class="grid gap-4 md:grid-cols-4">
    {steps.map(([t, d], i) => (
      <li class="card relative rounded-2xl bg-white p-6 ring-1 ring-black/[.06] dark:bg-white/[.04] dark:ring-white/10">
        <span class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-[#f5f5f7] font-mono text-base font-semibold tabular-nums text-slate-900 ring-1 ring-black/[.06] dark:bg-white/[.06] dark:text-white dark:ring-white/15">{String(i + 1).padStart(2, '0')}</span>
        <h2 class="font-semibold text-slate-900 dark:text-white">{t}</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{d}</p>
      </li>
    ))}
  </ol>
  <div class="mt-10 grid gap-8 lg:grid-cols-2 [&>*]:min-w-0">
    <section>
      <h2 class="mb-2 font-semibold">Add a researcher (<code>data/researchers.yaml</code>)</h2>
      <pre class={code}>{`- id: family-given            # lowercase slug, never changes
  name: Given Family
  sort_name: Family             # optional, when the family name is not last
  institution: University Name
  category: academia            # academia | industry | independent
  topics: [ai-software-testing]
  links:
    homepage: https://...
    dblp: https://dblp.org/pid/...
  sources: [https://...]        # page that shows the affiliation
  last_verified: "2026-11-22"`}</pre>
    </section>
    <section>
      <h2 class="mb-2 font-semibold">Add a paper (<code>data/papers.yaml</code>)</h2>
      <pre class={code}>{`- id: short-slug
  title: Exact Title from the Paper
  year: 2026
  authors: [First Author, Second Author]
  topics: [ai-agents]
  arxiv: "2601.00001"           # or doi: 10.xxxx/...
  links:
    paper: https://arxiv.org/abs/2601.00001
    code: https://github.com/...
  sources: [https://arxiv.org/abs/2601.00001]`}</pre>
    </section>
  </div>
  <section class="mt-10 max-w-3xl text-slate-700 dark:text-slate-300">
    <h2 class="mb-2 font-semibold text-slate-900 dark:text-white">Before you open a pull request</h2>
    <pre class={code}>{`python -m pip install -r scripts/requirements.txt
python scripts/validate.py`}</pre>
    <p class="mt-3 text-sm">Please copy titles and author lists exactly from the source, cite a page that shows each fact, and do not add citation counts, rankings or private contact details.</p>
  </section>
</Base>
