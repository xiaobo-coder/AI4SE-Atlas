---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TopicChip from '../components/TopicChip.astro';
import { papers, topics, authorLine, url } from '../utils/data';
const years = [...new Set(papers.map((p) => p.year))].sort((a, b) => b - a);
const sel = 'rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900';
---
<Base title="Papers" description="Selected AI4SE papers, listed chronologically.">
  <PageHeader eyebrow="Library" title="Selected papers" lead="Listed by date, newest first. A selection is not a ranking: these are papers that introduced a widely used benchmark, model, method or tool. Metadata comes from the arXiv record.">
    <p class="mt-3 text-sm"><a class="text-indigo-600 hover:underline dark:text-indigo-400" href={url('data/papers.bib')}>Download all as BibTeX</a></p>
  </PageHeader>
  <div class="md:sticky top-14 z-20 -mx-4 mb-6 flex flex-wrap gap-2 border-b border-slate-200 bg-white/90 px-4 py-3 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
    <label class="sr-only" for="p-q">Search title or author</label>
    <input id="p-q" type="search" placeholder="Search title or author…" class={sel + ' min-w-52 flex-1'} />
    <label class="sr-only" for="p-year">Year</label>
    <select id="p-year" class={sel}><option value="">All years</option>{years.map((y) => <option value={y}>{y}</option>)}</select>
    <label class="sr-only" for="p-topic">Topic</label>
    <select id="p-topic" class={sel}><option value="">All topics</option>{topics.map((t) => <option value={t.id}>{t.name}</option>)}</select>
    <label class="sr-only" for="p-order">Order</label>
    <select id="p-order" class={sel}><option value="desc">Newest first</option><option value="asc">Oldest first</option></select>
  </div>
  <p id="p-count" class="mb-4 text-sm text-slate-600 dark:text-slate-400" aria-live="polite"></p>
  <ol id="p-list" class="space-y-3">
    {papers.map((p, i) => (
      <li data-item data-i={i} data-year={p.year} data-topics={p.topics.join(' ')} data-text={(p.title + ' ' + p.authors.join(' ')).toLowerCase()}
        class="card result-enter rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-baseline gap-x-3">
          <span class="text-sm font-semibold tabular-nums text-indigo-600 dark:text-indigo-400">{p.year}</span>
          <a href={p.links.paper} class="font-semibold text-slate-900 hover:underline dark:text-white">{p.title}</a>
        </div>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-500 dark:text-slate-500 dark:text-slate-400">{authorLine(p.authors)}</p>
        <div class="mt-2 flex flex-wrap items-center gap-1.5">
          {p.topics.map((t) => <TopicChip id={t} />)}
          <span class="ml-auto flex gap-3 text-sm">
            {p.arxiv && <span class="text-slate-500 dark:text-slate-500 dark:text-slate-400">arXiv:{p.arxiv}</span>}
            <a href={p.links.paper} class="text-indigo-600 hover:underline dark:text-indigo-400">Paper</a>
            {p.links.code && <a href={p.links.code} class="text-indigo-600 hover:underline dark:text-indigo-400">Code</a>}
          </span>
        </div>
      </li>
    ))}
  </ol>
  <p id="p-empty" class="hidden rounded-xl border border-dashed border-slate-300 p-8 text-center text-slate-500 dark:border-slate-700">No paper matches these filters.</p>
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    const q = $('p-q'), year = $('p-year'), topic = $('p-topic'), order = $('p-order');
    const list = document.getElementById('p-list')!;
    const items = [...list.querySelectorAll<HTMLElement>('[data-item]')];
    function apply() {
      const words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const el of items) {
        const ok = words.every((w) => el.dataset.text!.includes(w)) && (!year.value || el.dataset.year === year.value) && (!topic.value || el.dataset.topics!.split(' ').includes(topic.value));
        el.hidden = !ok; if (ok) shown++;
      }
      const sorted = [...items].sort((a, b) => order.value === 'asc' ? (Number(a.dataset.year) - Number(b.dataset.year)) || (Number(a.dataset.i) - Number(b.dataset.i)) : Number(a.dataset.i) - Number(b.dataset.i));
      sorted.forEach((el) => list.appendChild(el));
      document.getElementById('p-count')!.textContent = `${shown} of ${items.length} papers`;
      document.getElementById('p-empty')!.classList.toggle('hidden', shown > 0);
    }
    q.addEventListener('input', apply); [year, topic, order].forEach((el) => el.addEventListener('change', apply));
    apply();
  </script>
</Base>
