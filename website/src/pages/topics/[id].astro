---
import Base from '../../layouts/Base.astro';
import AtlasMap from '../../components/AtlasMap.astro';
import TopicChip from '../../components/TopicChip.astro';
import { topics, researchers, papers, projects, authorLine, url, type Topic } from '../../utils/data';
export function getStaticPaths() { return topics.map((t) => ({ params: { id: t.id }, props: { t } })); }
const { t } = Astro.props as { t: Topic };
const rs = researchers.filter((r) => r.topics.includes(t.id));
const ps = papers.filter((p) => p.topics.includes(t.id));
const pj = projects.filter((p) => p.topics.includes(t.id));
const jsonld = { '@context': 'https://schema.org', '@type': 'DefinedTerm', name: t.name, description: t.description, termCode: t.id, inDefinedTermSet: 'AI4SE Atlas taxonomy' };
---
<Base title={t.name} description={t.description} jsonld={jsonld}>
  <nav class="mb-6 text-sm"><a class="text-indigo-600 hover:underline dark:text-indigo-400" href={url('topics/')}>← All topics</a></nav>
  <div class="grid items-start gap-8 lg:grid-cols-[1fr_1fr]">
    <div class="fade-in">
      <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">Topic · <code>{t.id}</code></p>
      <h1 class="display mt-4 !text-5xl sm:!text-6xl">{t.name}</h1>
      <p class="mt-5 text-lg text-slate-600 dark:text-slate-400">{t.description}</p>
      {t.related_topics && t.related_topics.length > 0 && <div class="mt-4 flex flex-wrap items-center gap-1.5 text-sm"><span class="text-slate-500">Related:</span>{t.related_topics.map((r) => <TopicChip id={r} />)}</div>}
    </div>
    <div class="text-slate-700 dark:text-slate-300"><AtlasMap highlight={t.id} compact /></div>
  </div>
  <div class="mt-10 grid gap-8 lg:grid-cols-3">
    <section><h2 class="mb-3 font-semibold">Researchers <span class="text-slate-500 dark:text-slate-400">({rs.length})</span></h2>
      {rs.length ? <ul class="space-y-2">{rs.map((r) => <li><a class="font-medium hover:underline" href={url(`researchers/${r.id}/`)}>{r.name}</a><div class="text-xs text-slate-500">{r.institution}</div></li>)}</ul> : <p class="text-sm text-slate-500">None yet.</p>}
    </section>
    <section><h2 class="mb-3 font-semibold">Papers <span class="text-slate-500 dark:text-slate-400">({ps.length})</span></h2>
      {ps.length ? <ul class="space-y-3">{ps.map((p) => <li><a class="font-medium hover:underline" href={p.links.paper}>{p.title}</a><div class="text-xs text-slate-500">{p.year} · {authorLine(p.authors, 3)}</div></li>)}</ul> : <p class="text-sm text-slate-500">None yet.</p>}
    </section>
    <section><h2 class="mb-3 font-semibold">Open-source projects <span class="text-slate-500 dark:text-slate-400">({pj.length})</span></h2>
      {pj.length ? <ul class="space-y-2">{pj.map((p) => <li><a class="font-medium hover:underline" href={p.repository}>{p.name}</a><div class="text-xs text-slate-500">{p.description}</div></li>)}</ul> : <p class="text-sm text-slate-500">None yet.</p>}
    </section>
  </div>
</Base>
