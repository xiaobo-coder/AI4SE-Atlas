---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import AtlasMap from '../../components/AtlasMap.astro';
import { topics, researchers, papers, projects, url } from '../../utils/data';
const n = (id: string, xs: { topics: string[] }[]) => xs.filter((x) => x.topics.includes(id)).length;
---
<Base title="Topics" description="The AI4SE Atlas research taxonomy.">
  <PageHeader eyebrow="Taxonomy" title="Research topics" lead={`${topics.length} broad areas of AI for Software Engineering. A record can belong to several topics. The taxonomy is versioned and open to discussion.`} />
  <div class="mx-auto mb-10 max-w-4xl text-slate-700 dark:text-slate-300"><AtlasMap /></div>
  <div class="grid gap-4 sm:grid-cols-2">
    {topics.map((t) => (
      <a href={url(`topics/${t.id}/`)} class="card group block rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <h2 class="font-semibold text-slate-900 dark:text-white">{t.name} <span class="inline-block text-indigo-500 transition-transform group-hover:translate-x-1">→</span></h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{t.description}</p>
        <p class="mt-3 text-xs text-slate-500">{n(t.id, researchers)} researchers · {n(t.id, papers)} papers · {n(t.id, projects)} projects · <code class="text-[11px]">{t.id}</code></p>
      </a>
    ))}
  </div>
</Base>
