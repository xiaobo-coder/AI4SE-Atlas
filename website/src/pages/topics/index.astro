---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import AtlasMap from '../../components/AtlasMap.astro';
import { topics, topicById, researchers, papers, projects, url } from '../../utils/data';
const n = (id: string, xs: { topics: string[] }[]) => xs.filter((x) => x.topics.includes(id)).length;
---
<Base title="Topics" description="The AI4SE Atlas research taxonomy.">
  <PageHeader eyebrow={`Taxonomy / ${topics.length} topics / v1`} title="Research" accent="topics." lead={`${topics.length} broad areas of AI for Software Engineering. A record can belong to several topics. The taxonomy is versioned and open to discussion.`} />
  <div class="mx-auto mb-10 max-w-4xl text-slate-700 dark:text-slate-300"><AtlasMap /></div>
  <ol class="space-y-5">
    {topics.map((t, i) => (
      <li>
        <a href={url(`topics/${t.id}/`)} class="group block rounded-2xl bg-white ring-1 ring-black/[.06] shadow-[0_1px_2px_rgba(0,0,0,.04),0_8px_24px_-12px_rgba(0,0,0,.12)] dark:bg-white/[.04] dark:ring-white/10 dark:shadow-none transition hover:-translate-y-0.5 hover:shadow-[0_2px_4px_rgba(0,0,0,.05),0_16px_32px_-12px_rgba(0,0,0,.18)] hover:ring-black/10 dark:hover:bg-white/[.06] dark:hover:ring-white/20">
          <div class="flex flex-col gap-6 p-6 sm:p-8 lg:flex-row lg:items-center">
            <div class="flex min-w-0 flex-1 gap-5">
              <span class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#f5f5f7] font-mono sm:flex text-base font-semibold tabular-nums text-slate-900 ring-1 ring-black/[.06] dark:bg-white/[.06] dark:text-white dark:ring-white/15">{String(i + 1).padStart(2, '0')}</span>
              <div class="min-w-0">
                <h2 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">{t.name}</h2>
                <p class="mt-2 max-w-2xl text-[16px] leading-relaxed tracking-[0.005em] text-slate-600 dark:text-slate-400">{t.description}</p>
                {t.related_topics && t.related_topics.length > 0 && (
                  <p class="mt-4 flex flex-wrap items-center gap-2"><span class="text-[11px] font-medium uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">Related</span>{t.related_topics.map((r) => <span class="rounded-full bg-black/5 px-2.5 py-1 text-xs text-slate-700 dark:bg-white/10 dark:text-slate-300">{topicById.get(r)?.short_name ?? r}</span>)}</p>
                )}
              </div>
            </div>
            <dl class="grid shrink-0 grid-cols-3 gap-px overflow-hidden rounded-xl bg-black/[.06] text-center dark:bg-white/10 lg:w-[25rem]">
              {[['Researchers', n(t.id, researchers)], ['Papers', n(t.id, papers)], ['Projects', n(t.id, projects)]].map(([k, v]) => (
                <div class="bg-slate-50 px-3 py-4 dark:bg-[#11131a]"><dd class="text-3xl font-semibold tabular-nums tracking-tight text-slate-900 dark:text-white">{v}</dd><dt class="text-[11px] font-medium uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400 mt-1">{k}</dt></div>
              ))}
            </dl>
          </div>
        </a>
      </li>
    ))}
  </ol>
</Base>
