---
import Base from '../layouts/Base.astro';
import AtlasMap from '../components/AtlasMap.astro';
import SearchIndex from '../components/SearchIndex.astro';
import Timeline from '../components/Timeline.astro';
import { researchers, papers, projects, topics, url } from '../utils/data';

const counts: Record<string, number> = {};
for (const t of topics) counts[t.id] = [...researchers, ...papers, ...projects].filter((x) => x.topics.includes(t.id)).length;
const sections = [
  { href: 'researchers/', title: 'Researchers', n: researchers.length, text: 'Browse A–Z across academia and industry.', color: 'from-indigo-500 to-violet-500' },
  { href: 'topics/', title: 'Topics', n: topics.length, text: 'Explore the research taxonomy.', color: 'from-cyan-500 to-sky-500' },
  { href: 'papers/', title: 'Papers', n: papers.length, text: 'Selected publications, by date.', color: 'from-fuchsia-500 to-pink-500' },
  { href: 'projects/', title: 'Projects', n: projects.length, text: 'Open-source research tools and benchmarks.', color: 'from-emerald-500 to-teal-500' },
];
const updated = [...researchers.map((r) => r.last_verified), ...papers.map((p) => p.last_verified ?? ''), ...projects.map((p) => p.last_verified ?? '')].filter(Boolean).sort().at(-1) ?? '';
const site = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : undefined;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Dataset', name: 'AI4SE Atlas',
  description: 'An open, curated, unranked directory of researchers, research topics, papers and open-source projects in AI for Software Engineering.',
  url: site, isAccessibleForFree: true, keywords: ['AI for Software Engineering', 'AI4SE', 'LLM', 'software engineering research'],
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: site ? new URL('data/atlas.json', site).href : undefined },
    { '@type': 'DataDownload', encodingFormat: 'application/x-bibtex', contentUrl: site ? new URL('data/papers.bib', site).href : undefined },
  ],
};
---
<Base title="AI4SE Atlas" jsonld={jsonld}>
  <section class="relative -mx-4 overflow-hidden px-4 pb-10 pt-10 sm:pt-16">
    <div class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>
    <div class="pointer-events-none absolute -top-40 right-[-10%] -z-10 h-[34rem] w-[34rem] rounded-full bg-teal-400/20 blur-3xl dark:bg-teal-400/10"></div>
    <p class="eyebrow fade-in">AI4SE Atlas / Updated {updated} / No rankings</p>
    <div class="mt-6 grid items-center gap-10 lg:grid-cols-[1.15fr_1fr] [&>*]:min-w-0">
      <div>
        <h1 class="display fade-in">Map the field of <span class="text-accent">AI for Software Engineering</span>.</h1>
        <p class="fade-in-2 mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
          Researchers, topics, papers and open-source projects in one open directory. Every researcher, paper and project cites a public source, and all of it can be reused as structured data.
        </p>
        <div class="fade-in-3 relative mt-8 max-w-xl">
          <label for="q" class="sr-only">Search the atlas</label>
          <input id="q" type="search" autocomplete="off" aria-controls="q-results" placeholder="Search researchers, topics, papers, projects…"
            class="w-full rounded-full border border-slate-300 bg-white/90 px-5 py-3.5 text-base shadow-sm outline-none transition focus:border-teal-500 focus:ring-4 focus:ring-teal-500/15 dark:border-white/15 dark:bg-white/5" />
          <p id="q-status" class="sr-only" aria-live="polite"></p>
          <ul id="q-results" aria-label="Search results" class="absolute z-20 mt-2 hidden max-h-96 w-full overflow-auto rounded-2xl border border-slate-200 bg-white p-1 shadow-xl dark:border-white/10 dark:bg-[#12141a]"></ul>
        </div>
        <div class="fade-in-3 mt-6 flex flex-wrap gap-3">
          <a href={url('explore/')} class="btn-accent">Explore the timeline →</a>
          <a href={url('contribute/')} class="btn-ghost">Contribute a record</a>
          <a href={url('data/atlas.json')} class="btn-ghost">Data (JSON)</a>
        </div>
      </div>
      <div class="text-slate-700 dark:text-slate-300"><AtlasMap counts={counts} /></div>
    </div>
  </section>

  <section class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-slate-200 bg-slate-200 lg:grid-cols-4 dark:border-white/10 dark:bg-white/10">
    {sections.map((s) => (
      <a href={url(s.href)} class="group bg-white p-6 transition-colors hover:bg-slate-50 dark:bg-[#0b0d12] dark:hover:bg-white/[.03]">
        <div class="stat text-slate-900 tabular-nums dark:text-white">{s.n}</div>
        <div class="eyebrow mt-3">{s.title} <span class="inline-block transition-transform group-hover:translate-x-1">→</span></div>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{s.text}</p>
      </a>
    ))}
  </section>

  <section class="mt-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div><p class="eyebrow">Timeline</p><h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">Papers over time, by topic</h2></div>
      <a href={url('explore/')} class="btn-ghost">Open the full view →</a>
    </div>
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 dark:border-white/10 dark:bg-white/[.02]"><Timeline id="home" compact /></div>
  </section>

  <section class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-slate-200 bg-slate-200 md:grid-cols-3 dark:border-white/10 dark:bg-white/10">
    <div class="bg-white p-6 dark:bg-[#0b0d12]"><p class="eyebrow">For people</p><p class="mt-2 text-slate-700 dark:text-slate-300">Find who works on what, and follow a topic from its key papers to the tools that implement them.</p></div>
    <div class="bg-white p-6 dark:bg-[#0b0d12]"><p class="eyebrow">For machines</p><p class="mt-2 text-slate-700 dark:text-slate-300">YAML source, JSON Schema contracts, JSON / CSV / BibTeX exports, schema.org and citation metadata, a sitemap and llms.txt.</p></div>
    <div class="bg-white p-6 dark:bg-[#0b0d12]"><p class="eyebrow">Fair by design</p><p class="mt-2 text-slate-700 dark:text-slate-300">No rankings and no citation counts. Researchers A–Z, papers by date. Corrections and removal on request.</p></div>
  </section>
  <SearchIndex />
  <script>
    const idx: { k: string; t: string; s: string; u: string }[] = JSON.parse(document.getElementById('search-index')!.textContent || '[]');
    const q = document.getElementById('q') as HTMLInputElement;
    const box = document.getElementById('q-results')!;
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    function render() {
      const term = q.value.trim().toLowerCase();
      if (!term) { box.classList.add('hidden'); box.innerHTML = ''; return; }
      const words = term.split(/\s+/);
      const hits = idx.filter((x) => words.every((w) => (x.t + ' ' + x.s + ' ' + x.k).toLowerCase().includes(w))).slice(0, 12);
      box.innerHTML = hits.length
        ? hits.map((h) => `<li class="result-enter"><a class="block rounded-lg px-3 py-2 hover:bg-slate-100 dark:hover:bg-slate-800" href="${esc(h.u)}"><span class="mr-2 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:bg-slate-800">${esc(h.k)}</span><span class="font-medium">${esc(h.t)}</span><span class="mt-0.5 block truncate text-xs text-slate-600 dark:text-slate-400">${esc(h.s)}</span></a></li>`).join('')
        : `<li class="px-3 py-3 text-sm text-slate-500">No match for “${esc(q.value)}”.</li>`;
      box.classList.remove('hidden');
      document.getElementById('q-status')!.textContent = `${hits.length} result${hits.length === 1 ? '' : 's'}`;
    }
    q.addEventListener('input', render);
    q.addEventListener('keydown', (e) => { if (e.key === 'Escape') { q.value = ''; render(); } });
    document.addEventListener('click', (e) => { if (!box.contains(e.target as Node) && e.target !== q) box.classList.add('hidden'); });
  </script>
</Base>
