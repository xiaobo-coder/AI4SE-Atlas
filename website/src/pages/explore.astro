---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Heatmap from '../components/Heatmap.astro';
import { papers, topics, url, authorLine, topicName } from '../utils/data';
import { monthLabel } from '../utils/viz';
const years = [...new Set(papers.map((p) => p.year))].sort((a, b) => a - b);
const sel = 'rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm dark:border-slate-700 dark:bg-slate-900';
const btn = 'inline-flex items-center gap-1.5 rounded-full border border-slate-300 px-3.5 py-1.5 text-sm font-medium hover:border-teal-400 hover:text-teal-600 dark:border-slate-700 dark:hover:text-teal-300';
---
<Base title="Explore" description="Interactive timeline and topic-by-year map of AI for Software Engineering papers in AI4SE Atlas.">
  <p class="eyebrow fade-in">Explore / {papers.length} papers / {topics.length} topics</p>
  <h1 class="display fade-in mt-3 max-w-4xl">The field, <span class="text-accent">over time</span>.</h1>
  <p class="fade-in-2 mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">Every dot is a paper, placed by its arXiv month and drawn once in each topic it belongs to. Hover to see the paper; the same paper lights up in every lane.</p>

  <section class="mt-10 rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 dark:border-white/10 dark:bg-white/[.02]">
    <div class="mb-4 flex flex-wrap items-center gap-2" role="group" aria-label="Filters">
      <label class="sr-only" for="x-q">Search</label>
      <input id="x-q" type="search" placeholder="Search title or author…" class={sel + ' min-w-48 flex-1'} />
      <label class="text-xs text-slate-600 dark:text-slate-400" for="x-from">From</label>
      <select id="x-from" class={sel}>{years.map((y, i) => <option value={y} selected={i === 0}>{y}</option>)}</select>
      <label class="text-xs text-slate-600 dark:text-slate-400" for="x-to">to</label>
      <select id="x-to" class={sel}>{years.map((y, i) => <option value={y} selected={i === years.length - 1}>{y}</option>)}</select>
      <label class="inline-flex items-center gap-2 text-sm"><input id="x-code" type="checkbox" class="accent-teal-500" /> With code</label>
      <span id="x-count" class="ml-auto font-mono text-xs text-slate-600 dark:text-slate-400" aria-live="polite"></span>
    </div>
    <Timeline id="explore" />
    <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-4 dark:border-slate-800">
      <span class="font-mono text-xs uppercase tracking-widest text-slate-600 dark:text-slate-400">AI4SE Atlas · CC BY 4.0</span>
      <span class="ml-auto flex flex-wrap gap-2">
        <a class={btn} href={url('data/papers.csv')} download>CSV</a>
        <a class={btn} href={url('data/papers.json')}>JSON</a>
        <a class={btn} href={url('data/papers.bib')}>BibTeX</a>
      </span>
    </div>
    <details class="mt-4">
      <summary class="cursor-pointer text-sm text-slate-600 dark:text-slate-400">Table view</summary>
      <div class="mt-3 max-h-96 overflow-auto">
        <table class="w-full text-left text-sm">
          <thead class="sticky top-0 bg-white dark:bg-slate-950"><tr class="border-b border-slate-200 dark:border-slate-800"><th class="py-2 pr-3 font-semibold">Month</th><th class="py-2 pr-3 font-semibold">Paper</th><th class="py-2 font-semibold">Topics</th></tr></thead>
          <tbody>{papers.map((p) => <tr class="border-b border-slate-100 align-top dark:border-slate-900"><td class="whitespace-nowrap py-1.5 pr-3 font-mono text-xs">{monthLabel(p)}</td><td class="py-1.5 pr-3"><a class="hover:underline" href={url(`papers/${p.id}/`)}>{p.title}</a><div class="text-xs text-slate-600 dark:text-slate-400">{authorLine(p.authors, 3)}</div></td><td class="py-1.5 text-xs">{p.topics.map(topicName).join(', ')}</td></tr>)}</tbody>
        </table>
      </div>
    </details>
  </section>

  <section class="mt-14">
    <p class="eyebrow">Coverage</p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Papers in the atlas per topic and year</h2>
    <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-400">This shows what the atlas covers so far, not how big a research area is. Gaps are invitations to contribute.</p>
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 dark:border-white/10 dark:bg-white/[.02]"><div class="mx-auto max-w-3xl"><Heatmap /></div></div>
  </section>
  <script>
    const root = document.querySelector('[data-timeline="explore"]')!;
    const meta = JSON.parse(root.querySelector('[data-meta]')!.textContent || '{}');
    const q = document.getElementById('x-q') as HTMLInputElement, from = document.getElementById('x-from') as HTMLSelectElement,
      to = document.getElementById('x-to') as HTMLSelectElement, code = document.getElementById('x-code') as HTMLInputElement;
    const dots = [...root.querySelectorAll<SVGCircleElement>('circle[data-pid]')];
    function apply() {
      const w = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean), a = +from.value, b = +to.value;
      const on = new Set<string>();
      for (const [pid, m] of Object.entries<any>(meta)) {
        const text = (m.t + ' ' + m.a).toLowerCase();
        if (w.every((x) => text.includes(x)) && m.y >= Math.min(a, b) && m.y <= Math.max(a, b) && (!code.checked || m.c)) on.add(pid);
      }
      dots.forEach((d) => d.classList.toggle('is-off', !on.has(d.dataset.pid!)));
      document.getElementById('x-count')!.textContent = `${on.size} of ${Object.keys(meta).length} papers`;
    }
    [q].forEach((e) => e.addEventListener('input', apply)); [from, to, code].forEach((e) => e.addEventListener('change', apply));
    apply();
  </script>
</Base>
