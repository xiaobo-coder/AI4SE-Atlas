---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import TopicChip from '../../components/TopicChip.astro';
import { researchers, topics, initial, CATEGORY_LABEL, url } from '../../utils/data';

const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ#'.split('');
const groups = new Map<string, typeof researchers>();
for (const r of researchers) { const l = initial(r); if (!groups.has(l)) groups.set(l, []); groups.get(l)!.push(r); }
const institutions = [...new Set(researchers.map((r) => r.institution))].sort((a, b) => a.localeCompare(b));
const sel = 'rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900';
---
<Base title="Researchers" description="AI4SE researchers in academia and industry, listed A–Z by family name.">
  <PageHeader eyebrow="Directory" title="Researchers" lead="Listed alphabetically by family name. Inclusion is not a ranking or an endorsement, and every entry cites a public source." />
  {researchers.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-slate-300 p-10 text-center text-slate-500 dark:border-slate-700">
      No researchers have been added yet. <a class="text-indigo-600 underline dark:text-indigo-400" href={url('contribute/')}>Suggest one</a>.
    </div>
  ) : (
  <div>
    <div class="md:sticky top-14 z-20 -mx-4 mb-6 border-b border-slate-200 bg-white/90 px-4 py-3 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
      <div class="flex flex-wrap gap-2">
        <label class="sr-only" for="r-q">Search by name</label>
        <input id="r-q" type="search" placeholder="Search by name…" class={sel + ' min-w-52 flex-1'} />
        <label class="sr-only" for="r-cat">Sector</label>
        <select id="r-cat" class={sel}><option value="">All sectors</option>{Object.entries(CATEGORY_LABEL).map(([v, l]) => <option value={v}>{l}</option>)}</select>
        <label class="sr-only" for="r-topic">Topic</label>
        <select id="r-topic" class={sel}><option value="">All topics</option>{topics.map((t) => <option value={t.id}>{t.name}</option>)}</select>
        <label class="sr-only" for="r-inst">Institution</label>
        <select id="r-inst" class={sel + ' max-w-60'}><option value="">All institutions</option>{institutions.map((i) => <option value={i}>{i}</option>)}</select>
      </div>
      <nav aria-label="Alphabet" class="mt-3 flex flex-wrap gap-1 text-xs font-semibold">
        {letters.map((l) => groups.has(l)
          ? <a href={`#letter-${l === '#' ? 'other' : l}`} data-letter={l} class="az-link rounded px-2 py-1 text-slate-700 hover:bg-indigo-100 dark:text-slate-300 dark:hover:bg-indigo-950">{l}</a>
          : <span class="rounded px-2 py-1 text-slate-300 dark:text-slate-700" aria-hidden="true">{l}</span>)}
      </nav>
    </div>
    <p id="r-count" class="mb-4 text-sm text-slate-600 dark:text-slate-400" aria-live="polite"></p>
    {[...groups.entries()].map(([l, list]) => (
      <section id={`letter-${l === '#' ? 'other' : l}`} data-group class="mb-8 scroll-mt-20 md:scroll-mt-56">
        <h2 class="mb-3 text-lg font-semibold text-slate-500 dark:text-slate-500 dark:text-slate-400">{l}</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {list.map((r) => (
            <a href={url(`researchers/${r.id}/`)} data-item data-name={r.name.toLowerCase()} data-cat={r.category} data-topics={r.topics.join(' ')} data-inst={r.institution}
              class="card result-enter block rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
              <div class="font-semibold text-slate-900 dark:text-white">{r.name}</div>
              <div class="text-sm text-slate-500 dark:text-slate-500 dark:text-slate-500 dark:text-slate-400">{r.institution} · {CATEGORY_LABEL[r.category]}</div>
              <div class="mt-2 flex flex-wrap gap-1">{r.topics.map((t) => <TopicChip id={t} link={false} />)}</div>
            </a>
          ))}
        </div>
      </section>
    ))}
    <p id="r-empty" class="hidden rounded-xl border border-dashed border-slate-300 p-8 text-center text-slate-500 dark:border-slate-700">No researcher matches these filters.</p>
  </div>
  )}
  <script>
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement | null;
    const q = $('r-q'), cat = $('r-cat'), topic = $('r-topic'), inst = $('r-inst');
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    const count = document.getElementById('r-count'), empty = document.getElementById('r-empty');
    function apply() {
      if (!q) return;
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      for (const el of items) {
        const ok = (!term || el.dataset.name!.includes(term)) && (!cat!.value || el.dataset.cat === cat!.value)
          && (!topic!.value || el.dataset.topics!.split(' ').includes(topic!.value)) && (!inst!.value || el.dataset.inst === inst!.value);
        el.hidden = !ok; if (ok) shown++;
      }
      for (const g of groups) g.hidden = !g.querySelector('[data-item]:not([hidden])');
      document.querySelectorAll<HTMLElement>('[data-letter]').forEach((a) => {
        const g = document.getElementById('letter-' + (a.dataset.letter === '#' ? 'other' : a.dataset.letter));
        a.style.opacity = g && !g.hidden ? '1' : '.3';
      });
      if (count) count.textContent = `${shown} of ${items.length} researchers`;
      empty?.classList.toggle('hidden', shown > 0);
    }
    [q, cat, topic, inst].forEach((el) => el?.addEventListener(el.tagName === 'INPUT' ? 'input' : 'change', apply));
    apply();
    // highlight the letter of the section in view
    const links = new Map([...document.querySelectorAll<HTMLElement>('[data-letter]')].map((a) => ['letter-' + (a.dataset.letter === '#' ? 'other' : a.dataset.letter), a]));
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { links.forEach((a) => a.removeAttribute('aria-current')); links.get(e.target.id)?.setAttribute('aria-current', 'true'); } }), { rootMargin: '-45% 0px -50% 0px' });
    groups.forEach((g) => io.observe(g));
  </script>
</Base>
