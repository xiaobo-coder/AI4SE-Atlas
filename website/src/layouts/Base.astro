---
import '../styles/global.css';
import { url } from '../utils/data';

interface Props { title: string; description?: string; jsonld?: object | object[] }
const { title, description = 'An open, curated, unranked directory of researchers, topics, papers and open-source projects in AI for Software Engineering.', jsonld } = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  ['Researchers', 'researchers/'], ['Topics', 'topics/'], ['Papers', 'papers/'], ['Projects', 'projects/'], ['About', 'about/'], ['Contribute', 'contribute/'],
];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === 'AI4SE Atlas' ? title : `${title} · AI4SE Atlas`;
---
<!doctype html>
<html lang="en" class="overflow-x-clip">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(url('og.png'), Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" type="application/json" title="AI4SE Atlas data" href={url('data/atlas.json')} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <script is:inline>
    (function () {
      var t = null; try { t = localStorage.getItem('theme'); } catch (_) {}
      if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
    })();
  </script>
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replace(/</g, '\\u003c')} />}
</head>
<body class="min-h-screen overflow-x-clip bg-white text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-indigo-600 focus:px-3 focus:py-2 focus:text-white">Skip to content</a>
  <header class="sticky top-0 z-30 border-b border-slate-200/70 bg-white/80 backdrop-blur dark:border-slate-800/70 dark:bg-slate-950/80">
    <div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4">
      <a href={url()} class="flex items-center gap-2 font-semibold tracking-tight text-slate-900 dark:text-white">
        <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-opacity=".25" stroke-width="2"/><circle cx="16" cy="6" r="3" fill="#6366f1"/><circle cx="7" cy="21" r="3" fill="#06b6d4"/><circle cx="25" cy="21" r="3" fill="#a855f7"/><path d="M16 6 7 21h18z" fill="none" stroke="currentColor" stroke-opacity=".5" stroke-width="1.5"/></svg>
        AI4SE Atlas
      </a>
      <nav aria-label="Main" class="ml-2 hidden items-center gap-1 text-sm md:flex">
        {nav.map(([label, href]) => {
          const active = path.startsWith('/' + href.replace(/\/$/, ''));
          return <a href={url(href)} aria-current={active ? 'page' : undefined}
            class:list={['rounded-md px-2.5 py-1.5 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-white', active ? 'bg-slate-100 font-medium text-slate-900 dark:bg-slate-800 dark:text-white' : 'text-slate-600 dark:text-slate-400']}>{label}</a>;
        })}
      </nav>
      <div class="ml-auto flex items-center gap-2">
        <button id="theme-toggle" type="button" class="rounded-md border border-slate-200 px-2.5 py-1.5 text-xs text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800" aria-label="Toggle dark mode">
          <span class="dark:hidden">Dark</span><span class="hidden dark:inline">Light</span>
        </button>
        <details class="relative md:hidden">
          <summary class="cursor-pointer list-none rounded-md border border-slate-200 px-2.5 py-1.5 text-xs dark:border-slate-700">Menu</summary>
          <nav aria-label="Mobile" class="absolute right-0 mt-2 w-44 rounded-lg border border-slate-200 bg-white p-1 shadow-lg dark:border-slate-700 dark:bg-slate-900">
            {nav.map(([label, href]) => <a href={url(href)} class="block rounded px-3 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800">{label}</a>)}
          </nav>
        </details>
      </div>
    </div>
  </header>
  <main id="main" class="mx-auto max-w-6xl px-4 pb-20 pt-8">
    <slot />
  </main>
  <footer class="border-t border-slate-200 py-8 text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4">
      <span>AI4SE Atlas · independently maintained · <strong class="font-medium">no rankings</strong>, entries are alphabetical or chronological.</span>
      <span class="ml-auto flex gap-4">
        <a class="hover:underline" href={url('data/atlas.json')}>JSON</a>
        <a class="hover:underline" href={url('data/papers.bib')}>BibTeX</a>
        <a class="hover:underline" href={url('about/')}>Corrections &amp; removal</a>
      </span>
    </div>
  </footer>
  <script is:inline>
    document.getElementById('theme-toggle').addEventListener('click', function () {
      var on = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', on ? 'dark' : 'light'); } catch (_) {}
    });
  </script>
</body>
</html>
