---
interface Props { title: string; lead?: string; eyebrow?: string; accent?: string }
const { title, lead, eyebrow, accent } = Astro.props;
---
<div class="relative -mx-4 mb-10 overflow-hidden px-4 pb-6 pt-6 sm:pt-10">
  <div class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>
  {eyebrow && <p class="eyebrow fade-in">{eyebrow}</p>}
  <h1 class="display fade-in mt-4 max-w-5xl">{title}{accent && <> <span class="text-accent">{accent}</span></>}</h1>
  {lead && <p class="fade-in-2 mt-6 max-w-3xl text-lg leading-relaxed text-slate-600 sm:text-xl dark:text-slate-400">{lead}</p>}
  <slot />
</div>
