---
interface Props { title: string; lead?: string; eyebrow?: string }
const { title, lead, eyebrow } = Astro.props;
---
<div class="fade-in mb-8">
  {eyebrow && <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">{eyebrow}</p>}
  <h1 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl dark:text-white">{title}</h1>
  {lead && <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-400">{lead}</p>}
  <slot />
</div>
