---
import { topicName, url } from '../utils/data';
interface Props { id: string; link?: boolean }
const { id, link = true } = Astro.props;
const cls = 'inline-flex items-center rounded-full bg-black/5 px-2.5 py-1 text-xs text-slate-700 dark:bg-white/10 dark:text-slate-300';
---
{link ? <a href={url(`topics/${id}/`)} class={cls + ' hover:bg-black/10 dark:hover:bg-white/15'}>{topicName(id)}</a> : <span class={cls}>{topicName(id)}</span>}
