---
import { topicName, url } from '../utils/data';
interface Props { id: string; link?: boolean }
const { id, link = true } = Astro.props;
const cls = 'inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-2 py-0.5 text-xs text-indigo-700 dark:border-indigo-900 dark:bg-indigo-950/60 dark:text-indigo-300';
---
{link ? <a href={url(`topics/${id}/`)} class={cls + ' hover:border-indigo-400'}>{topicName(id)}</a> : <span class={cls}>{topicName(id)}</span>}
