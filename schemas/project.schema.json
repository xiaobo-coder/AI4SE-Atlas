{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xiaobo-coder/AI4SE-Atlas/main/schemas/project.schema.json",
  "title": "project",
  "description": "Open-source research projects.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "description",
      "topics",
      "repository",
      "sources"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 80
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^<>]*$"
      },
      "description": {
        "type": "string",
        "minLength": 10,
        "maxLength": 300,
        "pattern": "^[^<>]*$"
      },
      "topics": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 80
        }
      },
      "repository": {
        "type": "string",
        "pattern": "^https?://[^\\s\"'<>]+$"
      },
      "related_papers": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 80
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^https?://[^\\s\"'<>]+$"
        }
      },
      "last_verified": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    }
  }
}