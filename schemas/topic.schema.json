{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xiaobo-coder/AI4SE-Atlas/main/schemas/topic.schema.json",
  "title": "topic",
  "description": "Research topic taxonomy.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "description"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 80
      },
      "name": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[^<>]*$"
      },
      "description": {
        "type": "string",
        "minLength": 10,
        "pattern": "^[^<>]*$"
      },
      "related_topics": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 80
        }
      },
      "short_name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 24,
        "pattern": "^[^<>]*$"
      }
    }
  }
}