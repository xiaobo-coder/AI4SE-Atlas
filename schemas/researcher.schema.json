{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xiaobo-coder/AI4SE-Atlas/main/schemas/researcher.schema.json",
  "title": "researcher",
  "description": "Researchers. No private contact data, citation counts or rankings.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "institution",
      "category",
      "topics",
      "sources",
      "last_verified"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 80
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "pattern": "^[^<>]*$"
      },
      "sort_name": {
        "type": "string",
        "minLength": 1,
        "description": "Optional sort key when the family name is not the last token.",
        "pattern": "^[^<>]*$"
      },
      "institution": {
        "type": "string",
        "minLength": 2,
        "pattern": "^[^<>]*$"
      },
      "category": {
        "enum": [
          "academia",
          "industry",
          "independent"
        ]
      },
      "topics": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 80
        }
      },
      "links": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "homepage": {
            "type": "string",
            "pattern": "^(|https?://[^\\s\"'<>]+)$"
          },
          "google_scholar": {
            "type": "string",
            "pattern": "^(|https?://[^\\s\"'<>]+)$"
          },
          "dblp": {
            "type": "string",
            "pattern": "^(|https?://[^\\s\"'<>]+)$"
          },
          "orcid": {
            "type": "string",
            "pattern": "^(|https?://[^\\s\"'<>]+)$"
          },
          "github": {
            "type": "string",
            "pattern": "^(|https?://[^\\s\"'<>]+)$"
          }
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^https?://[^\\s\"'<>]+$"
        }
      },
      "last_verified": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "aliases": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 2,
          "pattern": "^[^<>]*$"
        },
        "description": "Other spellings of the name used in author lists."
      }
    }
  }
}