{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xiaobo-coder/AI4SE-Atlas/main/schemas/paper.schema.json",
  "title": "paper",
  "description": "Selected papers.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "year",
      "authors",
      "topics",
      "links",
      "sources"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 80
      },
      "title": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[^<>]*$"
      },
      "year": {
        "type": "integer",
        "minimum": 1950,
        "maximum": 2100
      },
      "authors": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^<>]*$"
        }
      },
      "topics": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 80
        }
      },
      "arxiv": {
        "type": "string",
        "pattern": "^\\d{4}\\.\\d{4,5}$"
      },
      "doi": {
        "type": "string",
        "pattern": "^10\\.\\d{4,9}/\\S+$"
      },
      "links": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper"
        ],
        "properties": {
          "paper": {
            "type": "string",
            "pattern": "^https?://[^\\s\"'<>]+$"
          },
          "code": {
            "type": "string",
            "pattern": "^(|https?://[^\\s\"'<>]+)$"
          }
        }
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^https?://[^\\s\"'<>]+$"
        }
      },
      "last_verified": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    }
  }
}